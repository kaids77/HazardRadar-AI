# Copy this file to .env and fill in real values. Never commit .env.
# Only the local proxy reads .env. The Flutter app never reads it.
# The app authenticates with each user's Firebase ID token, so no shared token is needed.
GROQ_API_KEY=replace_with_your_groq_key
FIREBASE_PROJECT_ID=hazardradarai
RATE_LIMIT_PER_MINUTE=30
PORT=3000
