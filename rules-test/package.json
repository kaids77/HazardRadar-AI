{
  "name": "hazardradar-rules-test",
  "version": "1.0.0",
  "private": true,
  "description": "Automated tests for firestore.rules using the Firestore emulator.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "emulator:test": "firebase emulators:exec --only firestore --project demo-hazardradar \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.36.0"
  }
}
