rules_version = '2';

// Deny by default: any path not matched below is refused.
service firebase.storage {
  match /b/{bucket}/o {

    match /reports/{uid}/{fileName} {
      // Any signed-in user can view report photos.
      allow read: if request.auth != null;

      // Only the owner can upload, and only small JPEG or WebP images.
      // The 300 KB cap sits above the 150 KB app target.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 300 * 1024
        && request.resource.contentType.matches('image/(jpeg|webp)');

      // Owners can delete their own photos. Admins can purge spam.
      allow delete: if request.auth != null
        && (request.auth.uid == uid
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'ADMIN');
    }
  }
}
